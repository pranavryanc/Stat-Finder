# API / database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stat_finder
PORT=8787

# Set this when the browser and API are deployed on different origins.
# Example: https://statfinder.example.com
ALLOWED_ORIGIN=

# Frontend only. Leave blank in local development because Vite proxies /api.
# Example production value: https://api.statfinder.example.com
VITE_API_BASE_URL=
